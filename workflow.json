      "parameters": {
        "jsCode": "const entitlementData = $('IF Deadline Gate').item.json;\nconst llmOutput = $('Basic LLM Chain').item.json;\n\nreturn {\n  json: {\n    eventId: entitlementData.eventId,\n    isin: entitlementData.isin,\n    eventType: entitlementData.eventType,\n    mandatoryVoluntaryFlag: entitlementData.mandatoryVoluntaryFlag,\n    recordDate: entitlementData.recordDate,\n    electionDeadline: entitlementData.electionDeadline || '',\n    accountNumber: entitlementData.accountNumber || '',\n    clientName: entitlementData.clientName || '',\n    positionAsOfRecordDate: entitlementData.positionAsOfRecordDate || 0,\n    entitlementCash: entitlementData.entitlementCash || 0.00,\n    entitlementShares: entitlementData.entitlementShares || 0,\n    fractionalCash: entitlementData.fractionalCash || 0.00,\n    newPosition: entitlementData.newPosition || '',\n    escalationTier: entitlementData.escalationTier || 'NONE',\n    daysToDeadline: entitlementData.daysToDeadline !== null ? entitlementData.daysToDeadline : '',\n    llmNotificationDraft: llmOutput.text || '',\n    timestamp: new Date().toISOString()\n  }\n};"
      },

        "text": "={{ \"Draft a clear, professional corporate action client notification for event \" + $json.eventId + \". Event Type: \" + $json.eventType + \". Client Account: \" + ($json.accountNumber || \"N/A\") + \". Entitlement Cash: \" + ($json.entitlementCash !== null ? $json.entitlementCash : 0) + \". Entitlement Shares: \" + ($json.entitlementShares !== null ? $json.entitlementShares : 0) + \". Escalation Tier: \" + $json.escalationTier + \". Days to Deadline: \" + ($json.daysToDeadline !== null ? $json.daysToDeadline : \"N/A\") + \". DO NOT alter any financial figures.\" }}"
      },

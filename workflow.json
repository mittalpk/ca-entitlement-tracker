        448
      ]
    },
    {
      "parameters": {
        "jsCode": "const pos = parseFloat($json.positionAsOfRecordDate || 0);\nconst ratio = parseFloat($json.rightsRatio || 0);\nconst rightsEntitlement = Math.floor(pos * ratio);\n\nreturn {\n  json: {\n    ...$json,\n    entitlementCash: 0.00,\n    entitlementShares: rightsEntitlement,\n    fractionalCash: 0.00,\n    newPosition: null\n  }\n};"
      },
